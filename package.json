{
  "name": "playwright-nestjs",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n be,fe -c blue,green \"npm run start:dev -w backend\" \"npm run dev -w frontend\"",
    "dev:be": "npm run start:dev -w backend",
    "dev:fe": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint -w backend",
    "test": "npm test -w backend",
    "format": "prettier --write \"backend/{src,test}/**/*.ts\" \"frontend/**/*.{ts,vue}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.4.2"
  }
}
