PORT=3001
MONGODB_URI=mongodb://localhost:27017/browser-automation
# Origin of the Nuxt dev server, allowed by CORS / Socket.IO
FRONTEND_ORIGIN=http://localhost:3000
# Default headless mode for jobs (can be overridden per job)
HEADLESS=true
# Max Chrome contexts running at the same time across all jobs
MAX_CONCURRENCY=10
# Contexts per Chrome process before the pool launches another process
CONTEXTS_PER_BROWSER=8
STORAGE_DIR=./storage
# Chrome profiles (logged-in sessions). Default: %LOCALAPPDATA%browser-automationprofiles
# (outside the project). Existing profiles are moved there automatically.
# PROFILES_DIR=

# --- AI assistant ("Tạo bằng AI") ---
# Usually configured from the UI (Cài đặt → AI); these are fallbacks.
# Encrypts tokens saved from the UI. Generated automatically on first start if missing.
# SETTINGS_SECRET=<64 hex chars>
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=          # Bearer token instead of an API key (gateways)
# ANTHROPIC_BASE_URL=            # Anthropic-compatible gateway/proxy
# AI_MODEL=claude-opus-5-5
